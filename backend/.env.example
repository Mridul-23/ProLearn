# ==========================================
# CORE DJANGO SETTINGS
# ==========================================

# Generate a secure key for production (e.g., using python -c 'import django.core.management.utils; print(django.core.management.utils.get_random_secret_key())')
DJANGO_SECRET_KEY=django-insecure-your-local-dev-secret-key-change-me

# Set to True for local development, False for production
DJANGO_DEBUG=True

# Hosts/domains allowed to serve this Django site (comma-separated for multiple)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]


# ==========================================
# SECURITY & CORS / CSRF
# ==========================================

# URL of your frontend application (used for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# Trusted origins for CSRF protection, especially if frontend is on a separate port/domain
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# Database connection URL (e.g., dj-database-url format)
# Example for SQLite: sqlite:///db.sqlite3
# Example for PostgreSQL: postgres://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3


# ==========================================
# CLOUDINARY (MEDIA STORAGE)
# ==========================================

# Your Cloudinary account credentials (leave blank if not using media uploads locally)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here